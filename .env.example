FORCE_WELCOME=false

AUTH_URL=https://auth-dev
API_URL=https://api-dev

GOOGLE_SERVER_CLIENT_ID=server-client-id
GOOGLE_PEOPLE_API_URL=people-api

LOG_HTTP_ENABLED=true
LOG_HTTP_ALLOWLIST=
LOG_HTTP_DENYLIST=/auth,/login,/token,/refresh,/upload,/payment
LOG_HTTP_SENSITIVE_ENDPOINTS=/auth(/|$),/login(/|$),/logout(/|$),/register(/|$),/password(/|$),/token(/|$),/refresh(/|$),/otp(/|$),/verify(/|$),/upload(/|$),/payment(/|$)
